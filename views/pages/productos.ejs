<!DOCTYPE html>
<html class="light" lang="es">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Kanview - <%= titulo %></title>
<script nonce="<%= cspNonce %>" src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script nonce="<%= cspNonce %>" id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-fixed": "#002020",
                        "background": "#fbf9f8",
                        "tertiary-fixed-dim": "#ffb692",
                        "on-tertiary-fixed": "#341100",
                        "secondary-container": "#dcdddd",
                        "on-surface": "#1b1c1c",
                        "surface-variant": "#e4e2e2",
                        "inverse-on-surface": "#f2f0f0",
                        "on-secondary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "on-primary-fixed-variant": "#004f4f",
                        "surface-container": "#efeded",
                        "on-primary": "#ffffff",
                        "outline-variant": "#bdc9c8",
                        "on-primary-container": "#e3fffe",
                        "tertiary-container": "#a96039",
                        "on-error": "#ffffff",
                        "surface": "#fbf9f8",
                        "on-error-container": "#93000a",
                        "error": "#ba1a1a",
                        "secondary-fixed-dim": "#c6c6c7",
                        "on-secondary-fixed-variant": "#454747",
                        "surface-dim": "#dbdad9",
                        "on-secondary-fixed": "#1a1c1c",
                        "error-container": "#ffdad6",
                        "secondary-fixed": "#e2e2e2",
                        "surface-tint": "#006a6a",
                        "primary-fixed": "#93f2f2",
                        "surface-bright": "#fbf9f8",
                        "outline": "#6e7979",
                        "on-background": "#1b1c1c",
                        "tertiary-fixed": "#ffdbcb",
                        "surface-container-high": "#eae8e7",
                        "on-tertiary": "#ffffff",
                        "on-surface-variant": "#3e4949",
                        "secondary": "#5d5f5f",
                        "on-tertiary-fixed-variant": "#733512",
                        "primary-fixed-dim": "#76d6d5",
                        "inverse-surface": "#303030",
                        "on-secondary-container": "#5f6161",
                        "on-tertiary-container": "#fff9f7",
                        "primary": "#006565",
                        "surface-container-highest": "#e4e2e2",
                        "tertiary": "#8b4823",
                        "surface-container-low": "#f5f3f3",
                        "inverse-primary": "#76d6d5",
                        "primary-container": "#008080"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container-padding-desktop": "40px",
                        "card-gap": "24px",
                        "container-padding-mobile": "20px",
                        "gutter": "24px",
                        "base": "8px",
                        "section-margin": "64px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "label-md": ["Inter"],
                        "label-sm": ["Inter"],
                        "headline-md": ["Inter"],
                        "display": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "display": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }]
                    }
                }
            }
        }
    </script>
<style>
        .neomorphic-card {
            background-color: #ffffff;
            box-shadow: 8px 8px 16px rgba(0,0,0,0.03), -8px -8px 16px #FFFFFF;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-surface text-on-surface font-body-md min-h-screen flex antialiased">
<!-- SideNavBar -->
<%- include('../partials/sidebar') %>
<!-- TopNavBar -->
<header class="hidden md:flex justify-between items-center px-container-padding-desktop w-[calc(100%-16rem)] ml-64 fixed top-0 right-0 h-16 z-40 bg-background/80 backdrop-blur-md border-b border-outline-variant/30">
<div class="flex-1 flex items-center">
<div class="relative w-64 focus-within:ring-2 focus-within:ring-primary/20 rounded-full">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant" style="font-variation-settings: 'wght' 300">search</span>
<input class="w-full pl-10 pr-4 py-2 bg-surface-container-low border-none rounded-full font-label-md text-label-md text-on-surface focus:outline-none focus:ring-0 shadow-inner" id="buscador-productos" placeholder="Buscar productos..." type="text">
</div>
</div>
<div class="flex items-center gap-2">
<button class="p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-all focus-within:ring-2 focus-within:ring-primary/20">
<span class="material-symbols-outlined" style="font-variation-settings: 'wght' 300">notifications</span>
</button>
<button class="p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-all focus-within:ring-2 focus-within:ring-primary/20">
<span class="material-symbols-outlined" style="font-variation-settings: 'wght' 300">chat_bubble</span>
</button>
<button class="p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-all focus-within:ring-2 focus-within:ring-primary/20">
<span class="material-symbols-outlined" style="font-variation-settings: 'wght' 300">account_circle</span>
</button>
</div>
</header>
<!-- Main Content -->
<main class="flex-1 md:ml-64 pt-16 min-h-screen">
<div class="p-container-padding-mobile md:p-container-padding-desktop">
<!-- Header Section -->
<div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
<div>
<h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface" id="titulo-productos">Productos</h2>
<p class="font-body-md text-body-md text-on-surface-variant mt-1" id="subtitulo-productos">Explora el catálogo de productos.</p>
</div>
<button class="hidden bg-primary text-on-primary hover:brightness-110 px-6 py-3 rounded-[16px] font-label-md text-label-md items-center gap-2 transition-transform active:scale-95 shadow-[0_12px_24px_rgba(0,128,128,0.2)]" id="btn-agregar-producto" type="button">
<span class="material-symbols-outlined">add_box</span>
                    Agregar producto
                </button>
</div>
<!-- Catálogo -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-card-gap" id="grid-productos">
<p class="text-center font-body-md text-body-md text-on-surface-variant py-16 sm:col-span-2 xl:col-span-3">Cargando productos...</p>
</div>
</div>
</main>
<!-- Modal Crear / Editar Producto (solo admin) -->
<div class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/30 p-4" id="modal-producto">
<div class="neomorphic-card rounded-[24px] w-full max-w-lg p-6">
<div class="flex items-center justify-between mb-6">
<h3 class="font-headline-md text-headline-md text-on-surface" id="titulo-modal-producto">Agregar producto</h3>
<button class="w-10 h-10 rounded-full hover:bg-surface-container-low flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-colors" id="btn-cerrar-modal" type="button">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<form class="grid grid-cols-1 md:grid-cols-2 gap-4" id="form-producto">
<input id="producto-id" type="hidden">
<div class="flex flex-col gap-2 md:col-span-2">
<label class="font-label-md text-label-md text-on-surface" for="producto-nombre">Nombre</label>
<input class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder:text-outline/50" id="producto-nombre" placeholder="Ej: Silla ergonómica" required type="text">
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="producto-codigo">Código</label>
<input class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder:text-outline/50" id="producto-codigo" placeholder="P-001" required type="text">
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="producto-categoria">Categoría</label>
<select class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all" id="producto-categoria" required>
<option value="">Selecciona una categoría</option>
<option value="tela">Tela</option>
<option value="espuma">Espuma</option>
<option value="madera">Madera</option>
<option value="herraje">Herraje</option>
<option value="hilo">Hilo</option>
<option value="otro">Otro</option>
<option value="Oficina">Oficina (categoría anterior)</option>
<option value="Industrial">Industrial (categoría anterior)</option>
<option value="Hogar">Hogar (categoría anterior)</option>
<option value="Automoviles">Automóviles (categoría anterior)</option>
</select>
</div>
<div class="flex flex-col gap-2 md:col-span-2">
<label class="font-label-md text-label-md text-on-surface" for="producto-descripcion">Descripción</label>
<textarea class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder:text-outline/50" id="producto-descripcion" placeholder="Describe el producto" required rows="3"></textarea>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="producto-precio">Precio</label>
<input class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder:text-outline/50" id="producto-precio" min="0" placeholder="0" required step="0.01" type="number">
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="producto-stock">Stock</label>
<input class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder:text-outline/50" id="producto-stock" min="0" placeholder="0" required step="1" type="number">
</div>
<div class="md:col-span-2 flex justify-end gap-3 mt-2">
<button class="px-5 py-2.5 rounded-xl border border-outline-variant text-on-surface-variant hover:bg-surface-container-low transition-colors font-label-md text-label-md" id="btn-cancelar-producto" type="button">
                        Cancelar
                    </button>
<button class="px-5 py-2.5 rounded-xl bg-primary text-on-primary hover:brightness-110 transition-all active:scale-95 font-label-md text-label-md" type="submit">
                        Guardar
                    </button>
</div>
</form>
</div>
</div>
<!-- Toast de notificaciones -->
<div class="hidden" id="toast"></div>
<script nonce="<%= cspNonce %>">
        const token = localStorage.getItem('token');
        const tipo = localStorage.getItem('tipo');
        const esCliente = tipo === 'Cliente';
        let productos = [];
        let filtroTexto = '';
        let toastTimer;

        const CATEGORIA_CLASES = {
            tela: 'bg-primary-container/10 text-primary',
            espuma: 'bg-tertiary-fixed text-on-tertiary-fixed',
            madera: 'bg-amber-50 text-amber-700',
            herraje: 'bg-slate-100 text-slate-700',
            hilo: 'bg-secondary-container text-on-secondary-container',
            otro: 'bg-surface-container-highest text-on-surface-variant',
            Oficina: 'bg-primary-container/10 text-primary',
            Industrial: 'bg-tertiary-fixed text-on-tertiary-fixed',
            Hogar: 'bg-secondary-container text-on-secondary-container',
            Automoviles: 'bg-surface-container-highest text-on-surface-variant',
        };

        const apiFetch = async (url, opciones = {}) => {
            const respuesta = await fetch(url, {
                ...opciones,
                headers: {
                    'Content-Type': 'application/json',
                    Authorization: `Bearer ${token}`,
                    ...(opciones.headers || {}),
                },
            });

            if (respuesta.status === 401) {
                localStorage.removeItem('token');
                window.location.replace('/login');
                throw new Error('Sesión expirada');
            }

            const cuerpo = await respuesta.json().catch(() => ({}));

            if (!respuesta.ok) {
                throw new Error(cuerpo.message || 'Error al comunicarse con el servidor');
            }

            return cuerpo;
        };

        const escapeHtml = (valor) =>
            String(valor ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

        const mostrarToast = (mensaje, esError = false) => {
            const toast = document.getElementById('toast');
            toast.textContent = mensaje;
            toast.className = `fixed bottom-6 left-1/2 -translate-x-1/2 z-[80] px-6 py-3 rounded-full font-label-md text-label-md shadow-lg ${esError ? 'bg-error text-on-error' : 'bg-primary text-on-primary'}`;

            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.add('hidden'), 3000);
        };

        const precioTexto = (precio) => {
            const valor = precio && typeof precio === 'object' ? precio.$numberDecimal : precio;
            const numero = Number(valor);

            return Number.isFinite(numero)
                ? numero.toLocaleString('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 2, maximumFractionDigits: 2 })
                : '—';
        };

        const tarjetaProducto = (producto) => `
            <article class="neomorphic-card rounded-2xl p-5 flex flex-col" data-id="${escapeHtml(producto._id)}">
                <div class="flex items-start justify-between gap-2">
                    <span class="font-label-sm text-label-sm text-primary font-semibold">#${escapeHtml(producto.codigoProducto)}</span>
                    ${esCliente ? '' : `
                    <div class="flex items-center gap-1">
                        <button class="text-on-surface-variant hover:text-primary transition-colors p-1" data-accion="editar" data-id="${escapeHtml(producto._id)}" title="Editar producto">
                            <span class="material-symbols-outlined text-[18px]">edit</span>
                        </button>
                        <button class="text-on-surface-variant hover:text-error transition-colors p-1" data-accion="eliminar" data-id="${escapeHtml(producto._id)}" title="Eliminar producto">
                            <span class="material-symbols-outlined text-[18px]">delete</span>
                        </button>
                    </div>`}
                </div>
                <span class="self-start mt-3 px-2.5 py-0.5 rounded-full font-label-sm text-label-sm ${CATEGORIA_CLASES[producto.categoria] || 'bg-surface-container-highest text-on-surface-variant'}">${escapeHtml(producto.categoria)}</span>
                <h3 class="font-headline-md text-headline-md text-on-surface mt-3">${escapeHtml(producto.nombre)}</h3>
                <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 flex-1">${escapeHtml(producto.descripcion)}</p>
                <div class="flex items-center justify-between mt-4 pt-4 border-t border-outline-variant/30">
                    <span class="font-label-md text-label-md text-on-surface font-semibold">${escapeHtml(precioTexto(producto.precio))}</span>
                    ${esCliente ? `
                    <span class="flex items-center gap-1 font-label-sm text-label-sm ${producto.disponible ? 'text-emerald-700' : 'text-error'}">
                        <span class="material-symbols-outlined text-[16px]">${producto.disponible ? 'check_circle' : 'cancel'}</span>
                        ${producto.disponible ? 'Disponible' : 'Agotado'}
                    </span>` : `
                    <span class="flex items-center gap-1 font-label-sm text-label-sm ${producto.stock > 0 ? 'text-on-surface-variant' : 'text-error'}">
                        <span class="material-symbols-outlined text-[16px]">inventory_2</span>
                        ${escapeHtml(producto.stock)} un.
                    </span>`}
                </div>
            </article>`;

        const renderizarProductos = () => {
            const grid = document.getElementById('grid-productos');
            const texto = filtroTexto.toLowerCase();
            const visibles = productos.filter((producto) =>
                !texto ||
                String(producto.nombre || '').toLowerCase().includes(texto) ||
                String(producto.codigoProducto || '').toLowerCase().includes(texto) ||
                String(producto.descripcion || '').toLowerCase().includes(texto)
            );

            if (visibles.length === 0) {
                grid.innerHTML = '<p class="text-center font-body-md text-body-md text-on-surface-variant py-16 sm:col-span-2 xl:col-span-3">No hay productos que coincidan con la búsqueda.</p>';
                return;
            }

            grid.innerHTML = visibles.map(tarjetaProducto).join('');
        };

        const cargarProductos = async () => {
            try {
                const respuesta = await apiFetch('/api/productos');
                productos = respuesta.data || [];
                renderizarProductos();
            } catch (error) {
                mostrarToast(error.message, true);
            }
        };

        document.getElementById('buscador-productos').addEventListener('input', (evento) => {
            filtroTexto = evento.target.value.trim();
            renderizarProductos();
        });

        document.getElementById('grid-productos').addEventListener('click', async (evento) => {
            const boton = evento.target.closest('button[data-accion]');
            if (!boton) return;

            const producto = productos.find((item) => item._id === boton.dataset.id);
            if (!producto) return;

            if (boton.dataset.accion === 'editar') {
                abrirModalProducto(producto);
                return;
            }

            const confirmado = window.confirm(`¿Eliminar el producto ${producto.nombre}? Esta acción no se puede deshacer.`);
            if (!confirmado) return;

            try {
                await apiFetch(`/api/productos/${producto._id}`, { method: 'DELETE' });
                mostrarToast('Producto eliminado correctamente');
                await cargarProductos();
            } catch (error) {
                mostrarToast(error.message, true);
            }
        });

        const modalProducto = document.getElementById('modal-producto');
        const formProducto = document.getElementById('form-producto');

        const abrirModalProducto = (producto = null) => {
            formProducto.reset();
            document.getElementById('producto-id').value = producto ? producto._id : '';
            document.getElementById('titulo-modal-producto').textContent = producto ? 'Editar producto' : 'Agregar producto';

            if (producto) {
                const valorPrecio = producto.precio && typeof producto.precio === 'object'
                    ? producto.precio.$numberDecimal
                    : producto.precio;

                document.getElementById('producto-nombre').value = producto.nombre ?? '';
                document.getElementById('producto-codigo').value = producto.codigoProducto ?? '';
                document.getElementById('producto-categoria').value = producto.categoria ?? '';
                document.getElementById('producto-descripcion').value = producto.descripcion ?? '';
                document.getElementById('producto-precio').value = valorPrecio ?? '';
                document.getElementById('producto-stock').value = producto.stock ?? '';
            }

            modalProducto.classList.remove('hidden');
            modalProducto.classList.add('flex');
        };

        const cerrarModalProducto = () => {
            modalProducto.classList.add('hidden');
            modalProducto.classList.remove('flex');
        };

        formProducto.addEventListener('submit', async (evento) => {
            evento.preventDefault();

            const id = document.getElementById('producto-id').value;

            const datos = {
                nombre: document.getElementById('producto-nombre').value.trim(),
                codigoProducto: document.getElementById('producto-codigo').value.trim(),
                descripcion: document.getElementById('producto-descripcion').value.trim(),
                categoria: document.getElementById('producto-categoria').value,
                precio: Number(document.getElementById('producto-precio').value),
                stock: Number(document.getElementById('producto-stock').value),
            };

            try {
                if (id) {
                    await apiFetch(`/api/productos/${id}`, { method: 'PUT', body: JSON.stringify(datos) });
                    mostrarToast('Producto actualizado correctamente');
                } else {
                    await apiFetch('/api/productos', { method: 'POST', body: JSON.stringify(datos) });
                    mostrarToast('Producto creado correctamente');
                }

                cerrarModalProducto();
                await cargarProductos();
            } catch (error) {
                mostrarToast(error.message, true);
            }
        });

        document.getElementById('btn-agregar-producto').addEventListener('click', () => abrirModalProducto());
        document.getElementById('btn-cerrar-modal').addEventListener('click', cerrarModalProducto);
        document.getElementById('btn-cancelar-producto').addEventListener('click', cerrarModalProducto);
        modalProducto.addEventListener('click', (evento) => {
            if (evento.target === modalProducto) cerrarModalProducto();
        });
        document.addEventListener('keydown', (evento) => {
            if (evento.key === 'Escape') cerrarModalProducto();
        });

        document.getElementById('btn-logout-sidebar').addEventListener('click', async () => {
            try {
                await apiFetch('/api/auth/logout', { method: 'POST' });
            } catch (error) {
                console.warn('No se pudo cerrar la sesión en el servidor:', error.message);
            }

            localStorage.removeItem('token');
            localStorage.removeItem('tipo');
            localStorage.removeItem('nombre');
            window.location.replace('/login');
        });

        if (!token) {
            window.location.replace('/login');
        } else {
            if (esCliente) {
                document.querySelectorAll('[data-solo-admin]').forEach((elemento) => elemento.classList.add('hidden'));
                document.getElementById('subtitulo-productos').textContent = 'Explora el catálogo de productos.';
            } else {
                document.getElementById('subtitulo-productos').textContent = 'Gestiona el catálogo de productos.';

                const botonAgregar = document.getElementById('btn-agregar-producto');
                botonAgregar.classList.remove('hidden');
                botonAgregar.classList.add('flex');
            }

            cargarProductos();
        }
    </script>
</body>
</html>
