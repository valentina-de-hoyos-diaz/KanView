<!DOCTYPE html>
<html class="light" lang="es">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Kanview - <%= titulo %></title>
<script nonce="<%= cspNonce %>" src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script nonce="<%= cspNonce %>">
tailwind.config = { theme: { extend: { colors: { primary: '#006565', 'primary-container': '#008080', 'on-primary': '#ffffff', background: '#fbf9f8', 'on-surface': '#1b1c1c', 'on-surface-variant': '#3e4949', 'surface-container-low': '#f5f3f3', 'surface-container-lowest': '#ffffff', 'outline-variant': '#bdc9c8', error: '#ba1a1a' }, fontFamily: { sans: ['Inter'] } } } };
</script>
<style>
body { background: #fbf9f8; font-family: 'Inter', sans-serif; }
.card { background: #fff; box-shadow: 8px 8px 16px rgba(0,0,0,.03), -8px -8px 16px #fff; }
.material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }
</style>
</head>
<body class="text-on-surface min-h-screen">
<%- include('../partials/sidebar') %>

<main class="md:ml-64 p-5 md:p-10 max-w-[1440px] mx-auto">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div><h2 class="text-3xl font-semibold">Usuarios</h2><p class="text-on-surface-variant mt-1">Cuentas de acceso del personal, roles y vínculos con trabajadores.</p></div>
    <button class="bg-primary text-on-primary hover:brightness-110 px-6 py-3 rounded-2xl text-sm font-medium flex items-center justify-center gap-2" id="btn-agregar" type="button"><span class="material-symbols-outlined">person_add</span>Nuevo usuario</button>
  </div>

  <div id="error" class="hidden mb-5 bg-red-50 border border-red-200 text-error text-sm px-4 py-3 rounded-xl"></div>

  <div class="card rounded-2xl overflow-x-auto">
    <table class="w-full text-left text-sm min-w-[850px]">
      <thead class="text-xs uppercase tracking-wide text-on-surface-variant border-b border-outline-variant/40">
        <tr><th class="py-4 px-4">Usuario</th><th class="py-4 px-4">Rol</th><th class="py-4 px-4">Trabajador vinculado</th><th class="py-4 px-4">Estado</th><th class="py-4 px-4 text-right">Acciones</th></tr>
      </thead>
      <tbody id="tabla-usuarios" class="divide-y divide-outline-variant/20">
        <tr><td class="py-10 text-center text-on-surface-variant" colspan="5">Cargando usuarios...</td></tr>
      </tbody>
    </table>
  </div>
</main>

<div id="modal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/30 p-4">
  <div class="card rounded-2xl w-full max-w-lg p-6 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-2xl font-semibold" id="modal-titulo">Nuevo usuario</h3>
      <button class="w-10 h-10 rounded-full hover:bg-surface-container-low flex items-center justify-center" id="btn-cerrar" type="button"><span class="material-symbols-outlined">close</span></button>
    </div>
    <form id="form-usuario" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input id="usuario-id" type="hidden">
      <div class="md:col-span-2"><label class="text-sm" for="nombre">Nombre</label><input class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="nombre" required type="text"></div>
      <div class="md:col-span-2"><label class="text-sm" for="email">Correo</label><input class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="email" required type="email"></div>
      <div><label class="text-sm" for="rol">Rol</label><select class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="rol"><option value="trabajador">Trabajador</option><option value="secretaria">Secretaría</option><option value="admin">Administrador</option></select></div>
      <div><label class="text-sm" for="trabajador">Trabajador vinculado</label><select class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="trabajador"><option value="">Sin vínculo</option></select></div>
      <div class="md:col-span-2" id="campo-password"><label class="text-sm" for="password">Contraseña temporal</label><input class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="password" minlength="8" type="password"></div>
      <div class="md:col-span-2 flex items-center gap-2"><input id="activo" type="checkbox" checked><label class="text-sm" for="activo">Cuenta activa</label></div>
      <div class="md:col-span-2 flex justify-end gap-3 mt-2"><button class="px-5 py-2.5 rounded-xl border border-outline-variant" id="btn-cancelar" type="button">Cancelar</button><button class="px-5 py-2.5 rounded-xl bg-primary text-on-primary" type="submit">Guardar</button></div>
    </form>
  </div>
</div>

<script nonce="<%= cspNonce %>">
const token = localStorage.getItem('token');
const rolSesion = localStorage.getItem('rol') || '';
let usuarios = [];
let trabajadores = [];
let toastTimer;

const escapeHtml = (valor) => String(valor ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
const mostrarError = (mensaje) => { const el = document.getElementById('error'); el.textContent = mensaje; el.classList.remove('hidden'); };
const limpiarError = () => document.getElementById('error').classList.add('hidden');

const apiFetch = async (url, opciones = {}) => {
  const respuesta = await fetch(url, { ...opciones, headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}`, ...(opciones.headers || {}) } });
  if (respuesta.status === 401) { localStorage.clear(); window.location.replace('/login'); throw new Error('Sesión expirada'); }
  const cuerpo = await respuesta.json().catch(() => ({}));
  if (!respuesta.ok) throw new Error(cuerpo.message || 'Error del servidor');
  return cuerpo;
};

const insigniaRol = (rol) => {
  const clases = rol === 'admin' ? 'bg-red-50 text-red-700' : rol === 'secretaria' ? 'bg-amber-50 text-amber-700' : 'bg-emerald-50 text-emerald-700';
  return `<span class="px-2 py-1 rounded-full text-xs font-semibold ${clases}">${escapeHtml(rol)}</span>`;
};

const renderizar = () => {
  const tbody = document.getElementById('tabla-usuarios');
  if (!usuarios.length) { tbody.innerHTML = '<tr><td class="py-10 text-center text-on-surface-variant" colspan="5">No hay usuarios registrados.</td></tr>'; return; }
  tbody.innerHTML = usuarios.map((usuario) => `<tr class="hover:bg-surface-container-low/60">
    <td class="py-4 px-4"><p class="font-medium">${escapeHtml(usuario.nombre)}</p><p class="text-xs text-on-surface-variant">${escapeHtml(usuario.email)}</p></td>
    <td class="py-4 px-4">${insigniaRol(usuario.rol)}</td>
    <td class="py-4 px-4">${usuario.trabajadorId ? escapeHtml(usuario.trabajadorId.nombre) : '—'}</td>
    <td class="py-4 px-4"><span class="px-2 py-1 rounded-full text-xs font-semibold ${usuario.activo ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-error'}">${usuario.activo ? 'Activo' : 'Inactivo'}</span></td>
    <td class="py-4 px-4 text-right whitespace-nowrap">
      <button class="p-2 text-on-surface-variant hover:text-primary" data-accion="editar" data-id="${usuario._id}" title="Editar"><span class="material-symbols-outlined text-[20px]">edit</span></button>
      <button class="p-2 text-on-surface-variant hover:text-primary" data-accion="password" data-id="${usuario._id}" title="Restablecer contraseña"><span class="material-symbols-outlined text-[20px]">key</span></button>
      <button class="p-2 text-on-surface-variant hover:text-error" data-accion="desactivar" data-id="${usuario._id}" title="Desactivar"><span class="material-symbols-outlined text-[20px]">person_off</span></button>
    </td>
  </tr>`).join('');
};

const cargar = async () => {
  try {
    limpiarError();
    const [respuestaUsuarios, respuestaTrabajadores] = await Promise.all([
      apiFetch('/api/usuarios'),
      apiFetch('/api/trabajadores'),
    ]);
    usuarios = respuestaUsuarios.data || [];
    trabajadores = respuestaTrabajadores.data || [];
    renderizar();
  } catch (error) { mostrarError(error.message); }
};

const modal = document.getElementById('modal');
const form = document.getElementById('form-usuario');

const abrirModal = (usuario = null) => {
  form.reset();
  document.getElementById('usuario-id').value = usuario ? usuario._id : '';
  document.getElementById('modal-titulo').textContent = usuario ? 'Editar usuario' : 'Nuevo usuario';
  document.getElementById('campo-password').classList.toggle('hidden', Boolean(usuario));
  document.getElementById('password').required = !usuario;

  const selectTrabajador = document.getElementById('trabajador');
  selectTrabajador.innerHTML = '<option value="">Sin vínculo</option>' + trabajadores.map((trabajador) => `<option value="${trabajador._id}">${escapeHtml(trabajador.nombre)} (${escapeHtml(trabajador.documento)})</option>`).join('');

  if (usuario) {
    document.getElementById('nombre').value = usuario.nombre || '';
    document.getElementById('email').value = usuario.email || '';
    document.getElementById('rol').value = usuario.rol || 'trabajador';
    document.getElementById('activo').checked = usuario.activo !== false;
    selectTrabajador.value = usuario.trabajadorId ? (usuario.trabajadorId._id || usuario.trabajadorId) : '';
  } else {
    document.getElementById('activo').checked = true;
  }

  modal.classList.remove('hidden'); modal.classList.add('flex');
};

const cerrarModal = () => { modal.classList.add('hidden'); modal.classList.remove('flex'); };

form.addEventListener('submit', async (evento) => {
  evento.preventDefault();
  const id = document.getElementById('usuario-id').value;
  const datos = {
    nombre: document.getElementById('nombre').value.trim(),
    email: document.getElementById('email').value.trim(),
    rol: document.getElementById('rol').value,
    activo: document.getElementById('activo').checked,
    trabajadorId: document.getElementById('trabajador').value || null,
  };
  const password = document.getElementById('password').value;
  if (password) datos.password = password;

  try {
    if (id) {
      await apiFetch(`/api/usuarios/${id}`, { method: 'PUT', body: JSON.stringify(datos) });
    } else {
      await apiFetch('/api/usuarios', { method: 'POST', body: JSON.stringify(datos) });
    }
    cerrarModal(); await cargar();
  } catch (error) { mostrarError(error.message); }
});

document.getElementById('tabla-usuarios').addEventListener('click', async (evento) => {
  const boton = evento.target.closest('button[data-accion]');
  if (!boton) return;
  const usuario = usuarios.find((item) => item._id === boton.dataset.id);
  if (!usuario) return;

  if (boton.dataset.accion === 'editar') { abrirModal(usuario); return; }

  if (boton.dataset.accion === 'password') {
    const password = window.prompt(`Nueva contraseña temporal para ${usuario.email} (mínimo 8 caracteres):`);
    if (!password) return;
    try {
      await apiFetch(`/api/usuarios/${usuario._id}/password`, { method: 'PATCH', body: JSON.stringify({ password }) });
      window.alert('Contraseña restablecida. El usuario deberá cambiarla al ingresar.');
    } catch (error) { mostrarError(error.message); }
    return;
  }

  if (boton.dataset.accion === 'desactivar') {
    if (!window.confirm(`¿Desactivar la cuenta de ${usuario.email}?`)) return;
    try { await apiFetch(`/api/usuarios/${usuario._id}`, { method: 'DELETE' }); await cargar(); }
    catch (error) { mostrarError(error.message); }
  }
});

document.getElementById('btn-agregar').addEventListener('click', () => abrirModal());
document.getElementById('btn-cerrar').addEventListener('click', cerrarModal);
document.getElementById('btn-cancelar').addEventListener('click', cerrarModal);
modal.addEventListener('click', (evento) => { if (evento.target === modal) cerrarModal(); });
document.getElementById('btn-logout-sidebar').addEventListener('click', async () => {
  try { await apiFetch('/api/auth/logout', { method: 'POST' }); } catch (error) { console.warn(error.message); }
  localStorage.clear(); window.location.replace('/login');
});

if (!token) window.location.replace('/login');
else if (!['admin', 'secretaria'].includes(rolSesion)) window.location.replace('/dashboard');
else cargar();
</script>
</body>
</html>
