<!DOCTYPE html>
<html class="light" lang="es">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Kanview - <%= titulo %></title>
<script nonce="<%= cspNonce %>" src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script nonce="<%= cspNonce %>">tailwind.config={theme:{extend:{colors:{primary:'#006565','primary-container':'#008080','on-primary':'#ffffff',background:'#fbf9f8','on-surface':'#1b1c1c','on-surface-variant':'#3e4949','surface-container-low':'#f5f3f3','surface-container-lowest':'#ffffff','outline-variant':'#bdc9c8',error:'#ba1a1a'},fontFamily:{sans:['Inter']}}}};</script>
<style>body{background:#fbf9f8;font-family:'Inter',sans-serif}.card{background:#fff;box-shadow:8px 8px 16px rgba(0,0,0,.03),-8px -8px 16px #fff}.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 300,'GRAD' 0,'opsz' 24}</style>
</head>
<body class="text-on-surface min-h-screen">
<%- include('../partials/sidebar') %>

<main class="md:ml-64 p-5 md:p-10 max-w-[1440px] mx-auto">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div><h2 class="text-3xl font-semibold">Actividades</h2><p class="text-on-surface-variant mt-1">Tablero de actividades agrupado por estado, con filtros por área y trabajador.</p></div>
    <button class="bg-primary text-on-primary px-6 py-3 rounded-2xl text-sm font-medium flex items-center gap-2" id="btn-agregar" type="button"><span class="material-symbols-outlined">add</span>Nueva actividad</button>
  </div>
  <div class="flex flex-col md:flex-row gap-3 mb-5">
    <select class="px-4 py-2.5 rounded-xl border border-outline-variant bg-white text-sm" id="filtro-tarea"><option value="">Todas las tareas</option></select>
    <select class="px-4 py-2.5 rounded-xl border border-outline-variant bg-white text-sm" id="filtro-empleado"><option value="">Todos los trabajadores</option></select>
    <input class="px-4 py-2.5 rounded-xl border border-outline-variant bg-white text-sm" id="filtro-area" placeholder="Área o cargo (ej. tapicero)">
    <button class="px-4 py-2.5 rounded-xl border border-outline-variant bg-white text-sm" id="btn-filtrar" type="button">Filtrar</button>
  </div>
  <div id="error" class="hidden mb-5 bg-red-50 border border-red-200 text-error text-sm px-4 py-3 rounded-xl"></div>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5" id="tablero">
    <section class="rounded-2xl bg-surface-container-low border border-outline-variant/40 p-4 min-h-[300px]" data-columna="Pendiente"><h3 class="font-semibold mb-3 flex justify-between">Pendiente <span class="text-xs bg-white rounded-full px-2 py-1" data-contador>0</span></h3><div class="space-y-3" data-lista></div></section>
    <section class="rounded-2xl bg-surface-container-low border border-outline-variant/40 p-4 min-h-[300px]" data-columna="En progreso"><h3 class="font-semibold mb-3 flex justify-between">En progreso <span class="text-xs bg-white rounded-full px-2 py-1" data-contador>0</span></h3><div class="space-y-3" data-lista></div></section>
    <section class="rounded-2xl bg-surface-container-low border border-outline-variant/40 p-4 min-h-[300px]" data-columna="Completado"><h3 class="font-semibold mb-3 flex justify-between">Completado <span class="text-xs bg-white rounded-full px-2 py-1" data-contador>0</span></h3><div class="space-y-3" data-lista></div></section>
  </div>
</main>

<div id="modal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/30 p-4">
  <div class="card rounded-2xl w-full max-w-xl p-6 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-5"><h3 class="text-2xl font-semibold" id="modal-titulo">Nueva actividad</h3><button id="btn-cerrar" type="button" class="w-10 h-10 rounded-full hover:bg-surface-container-low"><span class="material-symbols-outlined">close</span></button></div>
    <form id="form-actividad" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input id="actividad-id" type="hidden">
      <div class="md:col-span-2"><label class="text-sm">Nombre</label><input class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="nombre" required></div>
      <div class="md:col-span-2"><label class="text-sm">Descripción</label><textarea class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="descripcion" required rows="3"></textarea></div>
      <div class="md:col-span-2"><label class="text-sm">Tarea</label><select class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="tarea" required></select></div>
      <div><label class="text-sm">Trabajador</label><select class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="empleado" required></select></div>
      <div><label class="text-sm">Estado</label><select class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="estado"><option>Pendiente</option><option>En progreso</option><option>Completado</option><option>Cancelado</option></select></div>
      <div><label class="text-sm">Fecha inicio</label><input class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="fechaInicio" required type="date"></div>
      <div><label class="text-sm">Fecha fin</label><input class="w-full mt-1 px-4 py-2.5 border border-outline-variant rounded-xl" id="fechaFin" required type="date"></div>
      <div class="md:col-span-2 flex justify-end gap-3"><button class="px-5 py-2.5 rounded-xl border border-outline-variant" id="btn-cancelar" type="button">Cancelar</button><button class="px-5 py-2.5 rounded-xl bg-primary text-on-primary" type="submit">Guardar</button></div>
    </form>
  </div>
</div>

<script nonce="<%= cspNonce %>">
const token = localStorage.getItem('token');
const rol = localStorage.getItem('rol') || '';
const trabajadorSesion = localStorage.getItem('trabajadorId') || '';
let actividades = [];
let tareas = [];
let trabajadores = [];

const escapeHtml = (valor) => String(valor ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
const mostrarError = (mensaje) => { const el = document.getElementById('error'); el.textContent = mensaje; el.classList.remove('hidden'); };
const limpiarError = () => document.getElementById('error').classList.add('hidden');
const fecha = (valor) => { const f = new Date(valor); return Number.isNaN(f.getTime()) ? '—' : f.toLocaleDateString('es-CO', { timeZone: 'UTC' }); };

const apiFetch = async (url, opciones = {}) => {
  const respuesta = await fetch(url, { ...opciones, headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}`, ...(opciones.headers || {}) } });
  if (respuesta.status === 401) { localStorage.clear(); window.location.replace('/login'); throw new Error('Sesión expirada'); }
  const cuerpo = await respuesta.json().catch(() => ({}));
  if (!respuesta.ok) throw new Error(cuerpo.message || 'Error del servidor');
  return cuerpo;
};

const tarjeta = (actividad) => {
  const tarea = actividad.idTarea || {};
  const pedido = tarea.idPedido || {};
  return `<article class="card rounded-xl p-4">
    <div class="flex items-start justify-between gap-2"><span class="text-xs font-semibold text-primary">${escapeHtml(pedido.codigoPedido || '—')} · ${escapeHtml(tarea.nombre || 'Tarea')}</span>
      <div class="flex gap-1"><button data-accion="editar" data-id="${actividad._id}" title="Editar"><span class="material-symbols-outlined text-[18px]">edit</span></button><button data-accion="eliminar" data-id="${actividad._id}" title="Desactivar"><span class="material-symbols-outlined text-[18px]">delete</span></button></div>
    </div>
    <h4 class="font-semibold mt-2">${escapeHtml(actividad.nombre)}</h4>
    <p class="text-sm text-on-surface-variant mt-1">${escapeHtml(actividad.descripcion)}</p>
    <p class="text-xs text-on-surface-variant mt-2">${escapeHtml(actividad.empleadoId?.nombre || 'Sin trabajador')} · ${escapeHtml(actividad.empleadoId?.cargo || '')}</p>
    <p class="text-xs text-on-surface-variant">${fecha(actividad.fechaInicio)} → ${fecha(actividad.fechaFin)}</p>
    <div class="flex gap-2 mt-3">
      ${actividad.estado !== 'Completado' ? `<button class="flex-1 rounded-lg bg-primary text-on-primary text-xs py-2" data-accion="completar" data-id="${actividad._id}">Completar</button>` : ''}
      ${actividad.estado === 'Pendiente' ? `<button class="flex-1 rounded-lg border border-outline-variant text-xs py-2" data-accion="iniciar" data-id="${actividad._id}">Iniciar</button>` : ''}
    </div>
  </article>`;
};

const renderizar = () => {
  const columnas = { Pendiente: [], 'En progreso': [], Completado: [] };
  actividades.forEach((actividad) => {
    const estado = actividad.estado === 'En proceso' ? 'En progreso' : actividad.estado;
    (columnas[estado] || columnas.Pendiente).push(actividad);
  });
  document.querySelectorAll('[data-columna]').forEach((columna) => {
    const datos = columnas[columna.dataset.columna] || [];
    columna.querySelector('[data-contador]').textContent = datos.length;
    columna.querySelector('[data-lista]').innerHTML = datos.length ? datos.map(tarjeta).join('') : '<p class="text-sm text-on-surface-variant text-center py-8">Sin actividades</p>';
  });
};

const cargarCatalogos = async () => {
  const [respuestaTareas, respuestaTrabajadores] = await Promise.all([apiFetch('/api/tareas'), apiFetch('/api/trabajadores')]);
  tareas = respuestaTareas.data || [];
  trabajadores = respuestaTrabajadores.data || [];
  document.getElementById('filtro-tarea').innerHTML = '<option value="">Todas las tareas</option>' + tareas.map((t) => `<option value="${t._id}">${escapeHtml(t.nombre)} · ${escapeHtml(t.idPedido?.codigoPedido || '')}</option>`).join('');
  document.getElementById('filtro-empleado').innerHTML = '<option value="">Todos los trabajadores</option>' + trabajadores.map((t) => `<option value="${t._id}">${escapeHtml(t.nombre)}</option>`).join('');
  document.getElementById('tarea').innerHTML = '<option value="">Selecciona una tarea</option>' + tareas.map((t) => `<option value="${t._id}">${escapeHtml(t.nombre)} · ${escapeHtml(t.idPedido?.codigoPedido || '')}</option>`).join('');
  document.getElementById('empleado').innerHTML = '<option value="">Selecciona un trabajador</option>' + trabajadores.map((t) => `<option value="${t._id}">${escapeHtml(t.nombre)} (${escapeHtml(t.cargo)})</option>`).join('');

  const params = new URLSearchParams(window.location.search);
  if (params.get('tarea')) document.getElementById('filtro-tarea').value = params.get('tarea');
  if (trabajadorSesion && !['admin', 'secretaria'].includes(rol)) document.getElementById('filtro-empleado').value = trabajadorSesion;
};

const filtros = () => {
  const params = new URLSearchParams();
  for (const [id, campo] of [['filtro-tarea', 'tareaId'], ['filtro-empleado', 'empleadoId']]) {
    const valor = document.getElementById(id).value;
    if (valor) params.set(campo, valor);
  }
  const area = document.getElementById('filtro-area').value.trim();
  if (area) params.set('area', area);
  return params.toString();
};

const cargar = async () => {
  try {
    limpiarError();
    const respuesta = await apiFetch(`/api/actividades?${filtros()}`);
    actividades = respuesta.data || [];
    renderizar();
  } catch (error) { mostrarError(error.message); }
};

const modal = document.getElementById('modal');
const form = document.getElementById('form-actividad');
const abrirModal = (actividad = null) => {
  form.reset();
  document.getElementById('actividad-id').value = actividad ? actividad._id : '';
  document.getElementById('modal-titulo').textContent = actividad ? 'Editar actividad' : 'Nueva actividad';
  if (actividad) {
    document.getElementById('nombre').value = actividad.nombre || '';
    document.getElementById('descripcion').value = actividad.descripcion || '';
    document.getElementById('tarea').value = actividad.idTarea ? (actividad.idTarea._id || actividad.idTarea) : '';
    document.getElementById('empleado').value = actividad.empleadoId ? (actividad.empleadoId._id || actividad.empleadoId) : '';
    document.getElementById('estado').value = actividad.estado || 'Pendiente';
    document.getElementById('fechaInicio').value = String(actividad.fechaInicio || '').slice(0, 10);
    document.getElementById('fechaFin').value = String(actividad.fechaFin || '').slice(0, 10);
  } else {
    const hoy = new Date().toISOString().slice(0, 10);
    document.getElementById('fechaInicio').value = hoy;
    document.getElementById('fechaFin').value = hoy;
    if (document.getElementById('filtro-tarea').value) document.getElementById('tarea').value = document.getElementById('filtro-tarea').value;
    if (trabajadorSesion) document.getElementById('empleado').value = trabajadorSesion;
  }
  modal.classList.remove('hidden'); modal.classList.add('flex');
};
const cerrarModal = () => { modal.classList.add('hidden'); modal.classList.remove('flex'); };

form.addEventListener('submit', async (evento) => {
  evento.preventDefault();
  const id = document.getElementById('actividad-id').value;
  const datos = {
    nombre: document.getElementById('nombre').value.trim(),
    descripcion: document.getElementById('descripcion').value.trim(),
    idTarea: document.getElementById('tarea').value,
    empleadoId: document.getElementById('empleado').value,
    estado: document.getElementById('estado').value,
    fechaInicio: document.getElementById('fechaInicio').value,
    fechaFin: document.getElementById('fechaFin').value,
  };
  try {
    if (id) await apiFetch(`/api/actividades/${id}`, { method: 'PUT', body: JSON.stringify(datos) });
    else await apiFetch('/api/actividades', { method: 'POST', body: JSON.stringify(datos) });
    cerrarModal(); await cargar();
  } catch (error) { mostrarError(error.message); }
});

const cambiarEstado = async (id, estado) => {
  try {
    await apiFetch(`/api/actividades/${id}`, { method: 'PUT', body: JSON.stringify({ estado }) });
    await cargar();
  } catch (error) { mostrarError(error.message); }
};

document.getElementById('tablero').addEventListener('click', async (evento) => {
  const boton = evento.target.closest('button[data-accion]');
  if (!boton) return;
  const actividad = actividades.find((item) => item._id === boton.dataset.id);
  if (!actividad) return;
  if (boton.dataset.accion === 'editar') return abrirModal(actividad);
  if (boton.dataset.accion === 'eliminar') {
    if (!window.confirm(`¿Desactivar la actividad "${actividad.nombre}"?`)) return;
    try { await apiFetch(`/api/actividades/${actividad._id}`, { method: 'DELETE' }); await cargar(); } catch (error) { mostrarError(error.message); }
    return;
  }
  if (boton.dataset.accion === 'completar') return cambiarEstado(actividad._id, 'Completado');
  if (boton.dataset.accion === 'iniciar') return cambiarEstado(actividad._id, 'En progreso');
});

document.getElementById('btn-agregar').addEventListener('click', () => abrirModal());
document.getElementById('btn-cerrar').addEventListener('click', cerrarModal);
document.getElementById('btn-cancelar').addEventListener('click', cerrarModal);
document.getElementById('btn-filtrar').addEventListener('click', cargar);
document.getElementById('filtro-tarea').addEventListener('change', cargar);
document.getElementById('filtro-empleado').addEventListener('change', cargar);
modal.addEventListener('click', (evento) => { if (evento.target === modal) cerrarModal(); });
document.getElementById('btn-logout-sidebar').addEventListener('click', async () => {
  try { await apiFetch('/api/auth/logout', { method: 'POST' }); } catch (error) { console.warn(error.message); }
  localStorage.clear(); window.location.replace('/login');
});

if (!token) window.location.replace('/login');
else if (rol === 'cliente') window.location.replace('/portal');
else cargarCatalogos().then(cargar).catch((error) => mostrarError(error.message));
</script>
</body>
</html>
