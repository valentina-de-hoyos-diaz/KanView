<!DOCTYPE html>
<html class="light" lang="es">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Kanview - <%= titulo %></title>
<script nonce="<%= cspNonce %>" src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script nonce="<%= cspNonce %>" id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-fixed": "#002020",
                        "background": "#fbf9f8",
                        "tertiary-fixed-dim": "#ffb692",
                        "on-tertiary-fixed": "#341100",
                        "secondary-container": "#dcdddd",
                        "on-surface": "#1b1c1c",
                        "surface-variant": "#e4e2e2",
                        "inverse-on-surface": "#f2f0f0",
                        "on-secondary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "on-primary-fixed-variant": "#004f4f",
                        "surface-container": "#efeded",
                        "on-primary": "#ffffff",
                        "outline-variant": "#bdc9c8",
                        "on-primary-container": "#e3fffe",
                        "tertiary-container": "#a96039",
                        "on-error": "#ffffff",
                        "surface": "#fbf9f8",
                        "on-error-container": "#93000a",
                        "error": "#ba1a1a",
                        "secondary-fixed-dim": "#c6c6c7",
                        "on-secondary-fixed-variant": "#454747",
                        "surface-dim": "#dbdad9",
                        "on-secondary-fixed": "#1a1c1c",
                        "error-container": "#ffdad6",
                        "secondary-fixed": "#e2e2e2",
                        "surface-tint": "#006a6a",
                        "primary-fixed": "#93f2f2",
                        "surface-bright": "#fbf9f8",
                        "outline": "#6e7979",
                        "on-background": "#1b1c1c",
                        "tertiary-fixed": "#ffdbcb",
                        "surface-container-high": "#eae8e7",
                        "on-tertiary": "#ffffff",
                        "on-surface-variant": "#3e4949",
                        "secondary": "#5d5f5f",
                        "on-tertiary-fixed-variant": "#733512",
                        "primary-fixed-dim": "#76d6d5",
                        "inverse-surface": "#303030",
                        "on-secondary-container": "#5f6161",
                        "on-tertiary-container": "#fff9f7",
                        "primary": "#006565",
                        "surface-container-highest": "#e4e2e2",
                        "tertiary": "#8b4823",
                        "surface-container-low": "#f5f3f3",
                        "inverse-primary": "#76d6d5",
                        "primary-container": "#008080"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container-padding-desktop": "40px",
                        "card-gap": "24px",
                        "container-padding-mobile": "20px",
                        "gutter": "24px",
                        "base": "8px",
                        "section-margin": "64px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "label-md": ["Inter"],
                        "label-sm": ["Inter"],
                        "headline-md": ["Inter"],
                        "display": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "display": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }]
                    }
                }
            }
        }
    </script>
<style>
        .neomorphic-card {
            background-color: #ffffff;
            box-shadow: 8px 8px 16px rgba(0,0,0,0.03), -8px -8px 16px #FFFFFF;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-surface text-on-surface font-body-md min-h-screen flex antialiased">
<!-- SideNavBar -->
<%- include('../partials/sidebar') %>
<!-- TopNavBar -->
<header class="hidden md:flex justify-between items-center px-container-padding-desktop w-[calc(100%-16rem)] ml-64 fixed top-0 right-0 h-16 z-40 bg-background/80 backdrop-blur-md border-b border-outline-variant/30">
<div class="flex-1 flex items-center">
<div class="relative w-64 focus-within:ring-2 focus-within:ring-primary/20 rounded-full">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant" style="font-variation-settings: 'wght' 300">search</span>
<input class="w-full pl-10 pr-4 py-2 bg-surface-container-low border-none rounded-full font-label-md text-label-md text-on-surface focus:outline-none focus:ring-0 shadow-inner" placeholder="Buscar pedidos..." type="text">
</div>
</div>
<div class="flex items-center gap-2">
<button class="p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-all focus-within:ring-2 focus-within:ring-primary/20">
<span class="material-symbols-outlined" style="font-variation-settings: 'wght' 300">notifications</span>
</button>
<button class="p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-all focus-within:ring-2 focus-within:ring-primary/20">
<span class="material-symbols-outlined" style="font-variation-settings: 'wght' 300">chat_bubble</span>
</button>
<button class="p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-all focus-within:ring-2 focus-within:ring-primary/20">
<span class="material-symbols-outlined" style="font-variation-settings: 'wght' 300">account_circle</span>
</button>
</div>
</header>
<!-- Main Content -->
<main class="flex-1 md:ml-64 pt-16 min-h-screen">
<div class="p-container-padding-mobile md:p-container-padding-desktop">
<!-- Header Section -->
<div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
<div>
<h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface" id="titulo-pedidos">Pedidos</h2>
<p class="font-body-md text-body-md text-on-surface-variant mt-1" id="subtitulo-pedidos">Tablero de pedidos</p>
</div>
<button class="hidden bg-primary text-on-primary hover:brightness-110 px-6 py-3 rounded-[16px] font-label-md text-label-md items-center gap-2 transition-transform active:scale-95 shadow-[0_12px_24px_rgba(0,128,128,0.2)]" id="btn-nuevo-pedido" type="button">
<span class="material-symbols-outlined">add</span>
<span id="texto-btn-pedido">Nuevo pedido</span>
                </button>
</div>
<!-- Tablero Kanban -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-card-gap" id="kanban-pedidos">
<!-- Columna: Pendiente -->
<section class="rounded-2xl bg-surface-container-low border border-outline-variant/40 p-4 flex flex-col min-h-[360px]" data-estado="Pendiente" data-kanban-columna>
<div class="flex items-center justify-between mb-4">
<div class="flex items-center gap-2">
<span class="w-2.5 h-2.5 rounded-full bg-outline"></span>
<h3 class="font-label-md text-label-md text-on-surface">Pendiente</h3>
</div>
<span class="px-2.5 py-0.5 rounded-full bg-surface-container-highest text-on-surface-variant font-label-sm text-label-sm" data-contador>0</span>
</div>
<div class="flex flex-col gap-3 flex-1" data-lista></div>
</section>
<!-- Columna: En proceso -->
<section class="rounded-2xl bg-surface-container-low border border-outline-variant/40 p-4 flex flex-col min-h-[360px]" data-estado="En proceso" data-kanban-columna>
<div class="flex items-center justify-between mb-4">
<div class="flex items-center gap-2">
<span class="w-2.5 h-2.5 rounded-full bg-tertiary"></span>
<h3 class="font-label-md text-label-md text-on-surface">En proceso</h3>
</div>
<span class="px-2.5 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-label-sm text-label-sm" data-contador>0</span>
</div>
<div class="flex flex-col gap-3 flex-1" data-lista></div>
</section>
<!-- Columna: Completado -->
<section class="rounded-2xl bg-surface-container-low border border-outline-variant/40 p-4 flex flex-col min-h-[360px]" data-estado="Completado" data-kanban-columna>
<div class="flex items-center justify-between mb-4">
<div class="flex items-center gap-2">
<span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
<h3 class="font-label-md text-label-md text-on-surface">Completado</h3>
</div>
<span class="px-2.5 py-0.5 rounded-full bg-primary-container/10 text-primary font-label-sm text-label-sm" data-contador>0</span>
</div>
<div class="flex flex-col gap-3 flex-1" data-lista></div>
</section>
<!-- Columna: Cancelado -->
<section class="rounded-2xl bg-surface-container-low border border-outline-variant/40 p-4 flex flex-col min-h-[360px]" data-estado="Cancelado" data-kanban-columna>
<div class="flex items-center justify-between mb-4">
<div class="flex items-center gap-2">
<span class="w-2.5 h-2.5 rounded-full bg-error"></span>
<h3 class="font-label-md text-label-md text-on-surface">Cancelado</h3>
</div>
<span class="px-2.5 py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm" data-contador>0</span>
</div>
<div class="flex flex-col gap-3 flex-1" data-lista></div>
</section>
</div>
</div>
</main>
<!-- Modal Crear Pedido (solo cliente) -->
<div class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/30 p-4" id="modal-pedido">
<div class="neomorphic-card rounded-[24px] w-full max-w-lg p-6">
<div class="flex items-center justify-between mb-6">
<h3 class="font-headline-md text-headline-md text-on-surface" id="titulo-modal-pedido">Nuevo pedido</h3>
<button class="w-10 h-10 rounded-full hover:bg-surface-container-low flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-colors" id="btn-cerrar-modal" type="button">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<form class="flex flex-col gap-4" id="form-pedido">
<div class="hidden flex-col gap-2" id="campo-cliente-pedido">
<label class="font-label-md text-label-md text-on-surface" for="pedido-cliente">Cliente</label>
<select class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all" id="pedido-cliente">
<option value="">Selecciona un cliente</option>
</select>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="pedido-descripcion">Descripción</label>
<textarea class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all placeholder:text-outline/50" id="pedido-descripcion" placeholder="Describe el pedido que quieres agendar" required rows="3"></textarea>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="pedido-producto">Producto</label>
<select class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all" id="pedido-producto" required>
<option value="">Selecciona un producto</option>
</select>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="pedido-fecha-entrega">Fecha límite de entrega</label>
<input class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all" id="pedido-fecha-entrega" type="date">
</div>
<div class="grid grid-cols-2 gap-4">
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="pedido-cantidad">Cantidad</label>
<input class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all" id="pedido-cantidad" min="1" required type="number" value="1">
</div>
<div class="flex flex-col gap-2">
<p class="font-label-md text-label-md text-on-surface">Total estimado</p>
<div class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant/40 rounded-xl flex items-center justify-end">
<span class="font-label-md text-label-md text-primary font-semibold" id="pedido-total">$0</span>
</div>
</div>
</div>
<p class="font-label-sm text-label-sm text-on-surface-variant" id="pedido-precio-detalle">Selecciona un producto para calcular el precio.</p>
<div class="flex justify-end gap-3 mt-2">
<button class="px-5 py-2.5 rounded-xl border border-outline-variant text-on-surface-variant hover:bg-surface-container-low transition-colors font-label-md text-label-md" id="btn-cancelar-pedido" type="button">
                        Cancelar
                    </button>
<button class="px-5 py-2.5 rounded-xl bg-primary text-on-primary hover:brightness-110 transition-all active:scale-95 font-label-md text-label-md" type="submit">
                        Crear pedido
                    </button>
</div>
</form>
</div>
</div>
<!-- Toast de notificaciones -->
<div class="hidden" id="toast"></div>
<script nonce="<%= cspNonce %>">
        const token = localStorage.getItem('token');
        const tipo = localStorage.getItem('tipo');
        const rol = localStorage.getItem('rol') || '';
        const esCliente = tipo === 'Cliente';
        const puedeAprobar = rol === 'admin' || rol === 'secretaria';
        let pedidos = [];
        let productosCatalogo = [];
        let toastTimer;

        const apiFetch = async (url, opciones = {}) => {
            const respuesta = await fetch(url, {
                ...opciones,
                headers: {
                    'Content-Type': 'application/json',
                    Authorization: `Bearer ${token}`,
                    ...(opciones.headers || {}),
                },
            });

            if (respuesta.status === 401) {
                localStorage.removeItem('token');
                window.location.replace('/login');
                throw new Error('Sesión expirada');
            }

            const cuerpo = await respuesta.json().catch(() => ({}));

            if (!respuesta.ok) {
                throw new Error(cuerpo.message || 'Error al comunicarse con el servidor');
            }

            return cuerpo;
        };

        const escapeHtml = (valor) =>
            String(valor ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

        const formatearFecha = (fecha) => {
            const fechaObj = new Date(fecha);
            return Number.isNaN(fechaObj.getTime())
                ? '—'
                : fechaObj.toLocaleDateString('es-CO', { timeZone: 'UTC' });
        };

        const mostrarToast = (mensaje, esError = false) => {
            const toast = document.getElementById('toast');
            toast.textContent = mensaje;
            toast.className = `fixed bottom-6 left-1/2 -translate-x-1/2 z-[80] px-6 py-3 rounded-full font-label-md text-label-md shadow-lg ${esError ? 'bg-error text-on-error' : 'bg-primary text-on-primary'}`;

            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.add('hidden'), 3000);
        };

        const tarjetaPedido = (pedido) => {
            const producto = pedido.producto || {};
            const clienteNombre = pedido.cliente && pedido.cliente.nombre ? pedido.cliente.nombre : '—';
            const cantidad = producto.cantidad ?? 1;
            const precio = producto.precio ?? 0;
            const total = (Number(cantidad) || 0) * (Number(precio) || 0);

            const aprobacion = pedido.estadoAprobacion || 'Aprobado';
            const aprobacionClases = aprobacion === 'Aprobado'
                ? 'bg-emerald-50 text-emerald-700'
                : aprobacion === 'Rechazado'
                    ? 'bg-error-container text-on-error-container'
                    : 'bg-tertiary-fixed text-on-tertiary-fixed';
            const accionesAprobacion = puedeAprobar && aprobacion === 'Pendiente'
                ? `<div class="flex gap-2 mt-3">
                    <button class="flex-1 rounded-lg bg-primary text-on-primary text-xs font-medium py-2" data-accion="aprobar" data-id="${escapeHtml(pedido._id)}">Aprobar</button>
                    <button class="flex-1 rounded-lg border border-error/40 text-error text-xs font-medium py-2" data-accion="rechazar" data-id="${escapeHtml(pedido._id)}">Rechazar</button>
                   </div>`
                : '';

            return `
                <article class="rounded-xl border border-outline-variant/40 bg-surface-container-lowest p-4 shadow-[0_2px_8px_rgba(0,0,0,0.04)] transition-shadow hover:shadow-[0_4px_12px_rgba(0,0,0,0.08)]" data-id="${escapeHtml(pedido._id)}">
                    <div class="flex items-start justify-between gap-2">
                        <span class="font-label-sm text-label-sm text-primary font-semibold">${escapeHtml(pedido.codigoPedido)}</span>
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold ${aprobacionClases}">${escapeHtml(aprobacion)}</span>
                            ${esCliente ? '' : `
                            <button class="text-on-surface-variant hover:text-error transition-colors" data-accion="eliminar" data-id="${escapeHtml(pedido._id)}" title="Desactivar pedido">
                                <span class="material-symbols-outlined text-[18px]">delete</span>
                            </button>`}
                        </div>
                    </div>
                    <p class="font-body-md text-body-md text-on-surface font-medium mt-2">${escapeHtml(producto.nombre || 'Producto')}</p>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1">${escapeHtml(pedido.descripcion)}</p>
                    ${esCliente ? '' : `<p class="font-label-sm text-label-sm text-on-surface-variant mt-2">Cliente: ${escapeHtml(clienteNombre)}</p>`}
                    ${aprobacion === 'Rechazado' && pedido.motivoRechazo ? `<p class="font-label-sm text-label-sm text-error mt-2">Motivo: ${escapeHtml(pedido.motivoRechazo)}</p>` : ''}
                    ${accionesAprobacion}
                    <div class="flex items-center justify-between mt-3 pt-3 border-t border-outline-variant/30">
                        <span class="font-label-sm text-label-sm text-on-surface-variant">${escapeHtml(cantidad)} × ${escapeHtml(formatearMoneda(precio))} = ${escapeHtml(formatearMoneda(total))}</span>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">${escapeHtml(formatearFecha(pedido.fechaEntrega || pedido.fechaCreacion))}</span>
                    </div>
                </article>`;
        };

        const renderizarKanban = () => {
            document.querySelectorAll('[data-kanban-columna]').forEach((columna) => {
                const lista = columna.querySelector('[data-lista]');
                const contador = columna.querySelector('[data-contador]');
                const pedidosColumna = pedidos.filter(
                    (pedido) => pedido.estadoPedido === columna.dataset.estado
                );

                contador.textContent = pedidosColumna.length;
                lista.innerHTML = pedidosColumna.length > 0
                    ? pedidosColumna.map(tarjetaPedido).join('')
                    : '<p class="text-center font-label-sm text-label-sm text-on-surface-variant/60 py-8">Sin pedidos</p>';

                if (rol === 'admin') {
                    lista.querySelectorAll('article').forEach((tarjeta) => {
                        tarjeta.draggable = true;
                        tarjeta.classList.add('cursor-grab', 'active:cursor-grabbing');
                        tarjeta.addEventListener('dragstart', (evento) => {
                            evento.dataTransfer.setData('text/plain', tarjeta.dataset.id);
                            tarjeta.classList.add('opacity-50');
                        });
                        tarjeta.addEventListener('dragend', () => tarjeta.classList.remove('opacity-50'));
                    });
                }
            });
        };

        const cargarPedidos = async () => {
            try {
                const respuesta = await apiFetch('/api/pedidos');
                pedidos = respuesta.data || [];
                renderizarKanban();
            } catch (error) {
                mostrarToast(error.message, true);
            }
        };

        const cargarClientesParaPedido = async () => {
            try {
                const respuesta = await apiFetch('/api/clientes');
                const clientes = respuesta.data || [];
                const select = document.getElementById('pedido-cliente');

                select.innerHTML = '<option value="">Selecciona un cliente</option>' + clientes
                    .map((cliente) => `<option value="${escapeHtml(cliente._id)}">${escapeHtml(cliente.nombre)} (${escapeHtml(cliente.documento)})</option>`)
                    .join('');
            } catch (error) {
                mostrarToast(error.message, true);
            }
        };

        const cargarProductosParaPedido = async () => {
            try {
                const respuesta = await apiFetch('/api/productos');
                productosCatalogo = respuesta.data || [];
                const select = document.getElementById('pedido-producto');

                select.innerHTML = productosCatalogo.length > 0
                    ? '<option value="">Selecciona un producto</option>' + productosCatalogo
                        .map((producto) => `<option value="${escapeHtml(producto._id)}">${escapeHtml(producto.nombre)} (${escapeHtml(producto.codigoProducto)})</option>`)
                        .join('')
                    : '<option value="">No hay productos registrados</option>';
            } catch (error) {
                mostrarToast(error.message, true);
            }
        };

        const precioDeProducto = (producto) => {
            const valor = producto.precio && typeof producto.precio === 'object'
                ? producto.precio.$numberDecimal
                : producto.precio;
            const numero = Number(valor);
            return Number.isFinite(numero) ? numero : 0;
        };

        const formatearMoneda = (numero) =>
            Number(numero || 0).toLocaleString('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 2, maximumFractionDigits: 2 });

        const actualizarTotalPedido = () => {
            const producto = productosCatalogo.find((item) => item._id === document.getElementById('pedido-producto').value);
            const cantidad = Number(document.getElementById('pedido-cantidad').value) || 0;
            const total = document.getElementById('pedido-total');
            const detalle = document.getElementById('pedido-precio-detalle');

            if (!producto) {
                total.textContent = formatearMoneda(0);
                detalle.textContent = 'Selecciona un producto para calcular el precio.';
                return;
            }

            const unitario = precioDeProducto(producto);
            total.textContent = formatearMoneda(unitario * cantidad);
            detalle.textContent = `${cantidad} × ${formatearMoneda(unitario)} (precio del catálogo)`;
        };

        document.querySelectorAll('[data-kanban-columna]').forEach((columna) => {
            columna.addEventListener('dragover', (evento) => {
                if (rol !== 'admin') return;
                evento.preventDefault();
                columna.classList.add('ring-2', 'ring-primary/30');
            });

            columna.addEventListener('dragleave', () => {
                columna.classList.remove('ring-2', 'ring-primary/30');
            });

            columna.addEventListener('drop', async (evento) => {
                evento.preventDefault();
                columna.classList.remove('ring-2', 'ring-primary/30');

                if (rol !== 'admin') return;

                const id = evento.dataTransfer.getData('text/plain');
                const pedido = pedidos.find((item) => item._id === id);
                const nuevoEstado = columna.dataset.estado;

                if (!pedido || pedido.estadoPedido === nuevoEstado) return;

                try {
                    await apiFetch(`/api/pedidos/${id}`, {
                        method: 'PUT',
                        body: JSON.stringify({ estadoPedido: nuevoEstado }),
                    });
                    mostrarToast(`Pedido ${pedido.codigoPedido} movido a ${nuevoEstado}`);
                    await cargarPedidos();
                } catch (error) {
                    mostrarToast(error.message, true);
                }
            });
        });

        document.getElementById('kanban-pedidos').addEventListener('click', async (evento) => {
            const boton = evento.target.closest('button[data-accion]');
            if (!boton) return;

            const pedido = pedidos.find((item) => item._id === boton.dataset.id);
            if (!pedido) return;

            if (boton.dataset.accion === 'aprobar') {
                try {
                    await apiFetch(`/api/pedidos/${pedido._id}/aprobar`, {
                        method: 'PATCH',
                        body: JSON.stringify({}),
                    });
                    mostrarToast(`Pedido ${pedido.codigoPedido} aprobado`);
                    await cargarPedidos();
                } catch (error) {
                    mostrarToast(error.message, true);
                }
                return;
            }

            if (boton.dataset.accion === 'rechazar') {
                const motivo = window.prompt(`Motivo del rechazo de ${pedido.codigoPedido}:`);
                if (!motivo || !motivo.trim()) return;

                try {
                    await apiFetch(`/api/pedidos/${pedido._id}/rechazar`, {
                        method: 'PATCH',
                        body: JSON.stringify({ motivo: motivo.trim() }),
                    });
                    mostrarToast(`Pedido ${pedido.codigoPedido} rechazado`);
                    await cargarPedidos();
                } catch (error) {
                    mostrarToast(error.message, true);
                }
                return;
            }

            if (boton.dataset.accion === 'eliminar') {
                const confirmado = window.confirm(`¿Desactivar el pedido ${pedido.codigoPedido}? El stock será devuelto.`);
                if (!confirmado) return;

                try {
                    await apiFetch(`/api/pedidos/${pedido._id}`, { method: 'DELETE' });
                    mostrarToast('Pedido desactivado correctamente');
                    await cargarPedidos();
                } catch (error) {
                    mostrarToast(error.message, true);
                }
            }
        });

        const modalPedido = document.getElementById('modal-pedido');
        const formPedido = document.getElementById('form-pedido');

        const abrirModalPedido = async () => {
            formPedido.reset();
            document.getElementById('pedido-cantidad').value = 1;
            document.getElementById('titulo-modal-pedido').textContent = esCliente ? 'Nuevo pedido' : 'Crear pedido';
            document.getElementById('pedido-cliente').required = !esCliente;

            const campoCliente = document.getElementById('campo-cliente-pedido');
            campoCliente.classList.toggle('hidden', esCliente);
            campoCliente.classList.toggle('flex', !esCliente);

            await cargarProductosParaPedido();
            actualizarTotalPedido();

            modalPedido.classList.remove('hidden');
            modalPedido.classList.add('flex');
        };

        document.getElementById('pedido-producto').addEventListener('change', actualizarTotalPedido);
        document.getElementById('pedido-cantidad').addEventListener('input', actualizarTotalPedido);

        const cerrarModalPedido = () => {
            modalPedido.classList.add('hidden');
            modalPedido.classList.remove('flex');
        };

        formPedido.addEventListener('submit', async (evento) => {
            evento.preventDefault();

            const productoSeleccionado = productosCatalogo.find(
                (item) => item._id === document.getElementById('pedido-producto').value
            );

            if (!productoSeleccionado) {
                mostrarToast('Selecciona un producto del catálogo', true);
                return;
            }

            const datos = {
                descripcion: document.getElementById('pedido-descripcion').value.trim(),
                producto: {
                    nombre: productoSeleccionado.nombre,
                    codigo: productoSeleccionado.codigoProducto,
                    cantidad: Number(document.getElementById('pedido-cantidad').value),
                },
            };

            if (!esCliente) {
                datos.cliente = document.getElementById('pedido-cliente').value;
            }

            const fechaEntrega = document.getElementById('pedido-fecha-entrega').value;
            if (fechaEntrega) datos.fechaEntrega = fechaEntrega;

            try {
                await apiFetch('/api/pedidos', { method: 'POST', body: JSON.stringify(datos) });
                mostrarToast('Pedido creado correctamente');
                cerrarModalPedido();
                await cargarPedidos();
            } catch (error) {
                mostrarToast(error.message, true);
            }
        });

        document.getElementById('btn-nuevo-pedido').addEventListener('click', abrirModalPedido);
        document.getElementById('btn-cerrar-modal').addEventListener('click', cerrarModalPedido);
        document.getElementById('btn-cancelar-pedido').addEventListener('click', cerrarModalPedido);
        modalPedido.addEventListener('click', (evento) => {
            if (evento.target === modalPedido) cerrarModalPedido();
        });
        document.addEventListener('keydown', (evento) => {
            if (evento.key === 'Escape') cerrarModalPedido();
        });

        document.getElementById('btn-logout-sidebar').addEventListener('click', async () => {
            try {
                await apiFetch('/api/auth/logout', { method: 'POST' });
            } catch (error) {
                console.warn('No se pudo cerrar la sesión en el servidor:', error.message);
            }

            localStorage.removeItem('token');
            localStorage.removeItem('tipo');
            localStorage.removeItem('nombre');
            window.location.replace('/login');
        });

        if (!token) {
            window.location.replace('/login');
        } else {
            if (esCliente) {
                document.querySelectorAll('[data-solo-admin]').forEach((elemento) => elemento.classList.add('hidden'));
                document.getElementById('titulo-pedidos').textContent = 'Mis Pedidos';
                document.getElementById('subtitulo-pedidos').textContent = 'Tus pedidos agendados, organizados por estado.';
                document.getElementById('texto-btn-pedido').textContent = 'Nuevo pedido';
            } else {
                document.getElementById('subtitulo-pedidos').textContent = 'Todos los pedidos de los clientes.';
                document.getElementById('texto-btn-pedido').textContent = 'Crear pedido';
                cargarClientesParaPedido();
            }

            const botonNuevo = document.getElementById('btn-nuevo-pedido');
            botonNuevo.classList.remove('hidden');
            botonNuevo.classList.add('flex');

            const campoFecha = document.getElementById('pedido-fecha-entrega');
            campoFecha.min = new Date().toISOString().slice(0, 10);

            cargarPedidos();
        }
    </script>
</body>
</html>
