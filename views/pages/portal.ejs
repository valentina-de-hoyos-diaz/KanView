<!DOCTYPE html>
<html class="light" lang="es">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Kanview - <%= titulo %></title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#006565",
                        "primary-container": "#008080",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#e3fffe",
                        "background": "#fbf9f8",
                        "on-surface": "#1b1c1c",
                        "on-surface-variant": "#3e4949",
                        "surface-container-low": "#f5f3f3",
                        "surface-container-lowest": "#ffffff",
                        "outline-variant": "#bdc9c8"
                    },
                    fontFamily: {
                        "sans": ["Inter"]
                    }
                }
            }
        }
    </script>
<style>
        body { background-color: #fbf9f8; font-family: 'Inter', sans-serif; }
        .neomorphic-card {
            background: #ffffff;
            box-shadow: 8px 8px 16px rgba(0,0,0,0.03), -8px -8px 16px #FFFFFF;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="text-on-surface antialiased min-h-screen flex items-center justify-center p-5">
<main class="neomorphic-card rounded-[24px] w-full max-w-md p-8 text-center relative overflow-hidden">
<svg class="absolute bottom-4 right-4 w-12 h-12 text-primary-container opacity-10 pointer-events-none" fill="currentColor" viewBox="0 0 24 24">
<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"></path>
</svg>
<div class="flex items-center justify-center gap-3 mb-6">
<span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings: 'FILL' 1;">chair</span>
<h1 class="text-2xl font-bold text-primary tracking-tight">Kanview</h1>
</div>
<div class="w-14 h-14 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center mx-auto mb-4">
<span class="material-symbols-outlined">person</span>
</div>
<h2 class="text-2xl font-semibold text-on-surface">Portal del Cliente</h2>
<p class="text-base text-on-surface-variant mt-2">
            Hola, <span class="font-medium text-on-surface" id="nombre-cliente">cliente</span>
</p>
<div class="mt-8 flex flex-col gap-3 text-left">
<a class="rounded-2xl bg-surface-container-low border border-outline-variant/30 p-4 block hover:border-primary/40 transition-colors" href="/pedidos">
<p class="text-sm font-medium text-on-surface">Tus pedidos</p>
<p class="text-xs text-on-surface-variant mt-1">Crea pedidos y revisa su estado en el tablero Kanban.</p>
</a>
<button class="w-full bg-primary hover:brightness-110 text-on-primary text-sm font-medium py-3 rounded-xl transition-all active:scale-[0.98] flex items-center justify-center gap-2" id="btn-logout">
<span class="material-symbols-outlined text-[20px]">logout</span>
                Cerrar sesión
            </button>
</div>
</main>
<script>
        const token = localStorage.getItem('token');
        const tipo = localStorage.getItem('tipo');

        if (!token) {
            window.location.replace('/login');
        } else if (tipo && tipo !== 'Cliente') {
            window.location.replace('/clientes');
        } else {
            document.getElementById('nombre-cliente').textContent = localStorage.getItem('nombre') || 'cliente';
        }

        document.getElementById('btn-logout').addEventListener('click', async () => {
            try {
                await fetch('/api/auth/logout', {
                    method: 'POST',
                    headers: { Authorization: `Bearer ${token}` },
                });
            } catch (error) {
                console.warn('No se pudo cerrar la sesión en el servidor:', error.message);
            }

            localStorage.removeItem('token');
            localStorage.removeItem('tipo');
            localStorage.removeItem('nombre');
            window.location.replace('/login');
        });
    </script>
</body>
</html>
