<body class="bg-background text-on-background h-screen w-full flex overflow-hidden font-body-md text-body-md antialiased">
<!-- Left Side: Registration Form -->
<main class="w-full md:w-1/2 flex flex-col justify-center items-center p-container-padding-mobile md:p-container-padding-desktop relative z-10 bg-surface-container-lowest h-full overflow-y-auto">
<div class="w-full max-w-[560px] flex flex-col gap-8 py-8">
<!-- Brand / Header -->
<div class="flex flex-col gap-2 text-center md:text-left">
<div class="flex items-center justify-center md:justify-start gap-3 mb-6">
<span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings: 'FILL' 1;">chair</span>
<h1 class="font-headline-md text-headline-md text-primary font-bold tracking-tight">Kanview</h1>
</div>
<h2 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface">Registro de trabajador</h2>
<p class="font-body-md text-body-md text-on-surface-variant mt-2">Completa los datos del nuevo integrante del taller.</p>
</div>
<!-- Messages -->
<div id="mensaje" class="hidden rounded-xl px-4 py-3 font-label-md text-label-md border" role="alert"></div>
<!-- Form -->
<form id="form-trabajador" class="flex flex-col gap-5">
<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
<div class="flex flex-col gap-2 md:col-span-2">
<label class="font-label-md text-label-md text-on-surface" for="nombre">Nombre completo</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-outline z-10 pointer-events-none">person</span>
<input class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-inner-neomorphic placeholder:text-outline/50" id="nombre" name="nombre" placeholder="Ej. María González" required type="text"/>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="documento">Documento</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-outline z-10 pointer-events-none">badge</span>
<input class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-inner-neomorphic placeholder:text-outline/50" id="documento" name="documento" placeholder="N.º de identificación" required type="text"/>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="celular">Celular</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-outline z-10 pointer-events-none">call</span>
<input class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-inner-neomorphic placeholder:text-outline/50" id="celular" name="celular" placeholder="Ej. 300 123 4567" required type="tel"/>
</div>
</div>
<div class="flex flex-col gap-2 md:col-span-2">
<label class="font-label-md text-label-md text-on-surface" for="direccion">Dirección</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-outline z-10 pointer-events-none">location_on</span>
<input class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-inner-neomorphic placeholder:text-outline/50" id="direccion" name="direccion" placeholder="Calle, número, barrio" required type="text"/>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="edad">Edad</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-outline z-10 pointer-events-none">calendar_today</span>
<input class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-inner-neomorphic placeholder:text-outline/50" id="edad" min="18" name="edad" placeholder="Ej. 30" required type="number"/>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="fechaNacimiento">Fecha de nacimiento</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-outline z-10 pointer-events-none">cake</span>
<input class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-inner-neomorphic placeholder:text-outline/50" id="fechaNacimiento" name="fechaNacimiento" required type="date"/>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="cargo">Cargo</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-outline z-10 pointer-events-none">work</span>
<input class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-inner-neomorphic placeholder:text-outline/50" id="cargo" name="cargo" placeholder="Ej. Carpintero" required type="text"/>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="RH">RH (tipo de sangre)</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-outline z-10 pointer-events-none">bloodtype</span>
<select class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-inner-neomorphic" id="RH" name="RH" required>
<option value="" disabled selected>Selecciona un RH</option>
<option value="A+">A+</option>
<option value="A-">A-</option>
<option value="B+">B+</option>
<option value="B-">B-</option>
<option value="AB+">AB+</option>
<option value="AB-">AB-</option>
<option value="O+">O+</option>
<option value="O-">O-</option>
</select>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="salario">Salario</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-outline z-10 pointer-events-none">payments</span>
<input class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-inner-neomorphic placeholder:text-outline/50" id="salario" min="0" name="salario" placeholder="Ej. 1500000" required step="0.01" type="number"/>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface" for="tareasRealizadas">Tareas realizadas</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-4 text-outline z-10 pointer-events-none">checklist</span>
<input class="w-full pl-11 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all shadow-inner-neomorphic placeholder:text-outline/50" id="tareasRealizadas" min="0" name="tareasRealizadas" placeholder="Ej. 0" required type="number"/>
</div>
</div>
</div>
<button class="mt-4 w-full bg-primary hover:bg-primary-fixed-dim text-on-primary font-label-md text-label-md py-3.5 rounded-2xl shadow-[0_12px_24px_rgba(0,128,128,0.2)] hover:shadow-[0_16px_32px_rgba(0,128,128,0.3)] transition-all duration-300 active:scale-[0.98] flex justify-center items-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed" id="btn-registrar" type="submit">
                    Registrar trabajador
                    <span class="material-symbols-outlined text-[20px]">person_add</span>
</button>
</form>
<p class="text-center font-body-md text-body-md text-on-surface-variant mt-4">
                ¿Ya tienes una cuenta?
                <a class="text-primary font-semibold hover:underline decoration-2 underline-offset-4" href="/login">Iniciar sesión</a>
</p>
</div>
</main>
<!-- Right Side: Decorative Image & Branding -->
<aside class="hidden md:flex w-1/2 h-full relative bg-surface-container-low overflow-hidden items-center justify-center">
<!-- Background Artistic Image -->
<div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-90 transition-transform duration-[20s] ease-linear hover:scale-100" data-alt="A meticulously arranged flat lay of premium artisanal furniture materials, including rich full-grain leather swatches, beautifully grained walnut wood samples, and textured linen fabrics. The scene is illuminated by soft, natural studio lighting that highlights the textures and quality of the materials. The color palette is warm, earthy, and sophisticated, reflecting a high-end, bespoke manufacturing environment. A light-mode aesthetic dominates with gentle neomorphic shadows adding depth to the arranged samples." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBrzAYaVFByjiY_CENmN7M9_C_77bnhfyiQMMfN6e78FO_dHnDYcM7fxZYCvye5nfodqfWrjJ0XfgEcb0CUKA_llwRz_pi7eXxw71m2MvOMnfZ4JRTAABiFt_C8eNonDTnbdwLSbm2TlnH-gnXHCUwm0QbjI4G0VJ8CIXhCJDDt08uJvy5q04HCOb7gxi2Ox6QkBa7Lp1GnGhtwQqkE6zk3ZPeKQFsD87kOpb8l4T6RndRureE_KmsUEQ')">
</div>
<!-- Subtle Overlay for contrast -->
<div class="absolute inset-0 bg-gradient-to-tr from-surface/80 via-surface/40 to-transparent mix-blend-overlay"></div>
<div class="absolute inset-0 bg-primary/5 mix-blend-multiply"></div>
<!-- Foreground Branding Element (Wax Seal) -->
<div class="relative z-10 flex flex-col items-center justify-center p-12 backdrop-blur-sm bg-surface/20 rounded-[3rem] border border-white/20 shadow-[0_32px_64px_rgba(0,0,0,0.1)]">
<img alt="Kanview Artisanal Seal" class="w-64 h-64 object-contain drop-shadow-2xl hover:scale-105 transition-transform duration-700 ease-out" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD9DWS7V6XBDwqXiGkMlitu2tPJQth16OR7LRrY0Nvt87cIX36Vfa1tsQHpsJZMEKCAhvHizJvNyPlu-vVdlapT_lyw_jNk5k1matTxqI_IIsBqXb_4IIYy5jWdE3wiF5rl8-jv_NmU_HHu1bJnCRhX98OS32DLZXBloowUKPlQK40F2npciWb2wk6y4KVXn4pYJGW0_i0bgrCIYYWsohkZoWde_zmHw_-5_oA9gjMkgbRm91_7A2UCLw"/>
<div class="mt-12 text-center max-w-sm">
<h3 class="font-headline-md text-headline-md text-on-surface-variant font-bold tracking-wide">Artesanía Digital</h3>
<p class="font-body-md text-body-md text-on-surface-variant/80 mt-4 leading-relaxed">
                    Registra a tu equipo con el mismo detalle y dedicación con que crean tus productos.
                </p>
</div>
</div>
<!-- Decorative UI Elements -->
<div class="absolute bottom-12 right-12 flex gap-3">
<div class="w-2 h-2 rounded-full bg-primary shadow-[0_0_12px_rgba(0,128,128,0.6)]"></div>
<div class="w-2 h-2 rounded-full bg-outline-variant/50"></div>
<div class="w-2 h-2 rounded-full bg-outline-variant/50"></div>
</div>
</aside>
<script>
(function () {
    var form = document.getElementById('form-trabajador');
    var btn = document.getElementById('btn-registrar');
    var mensaje = document.getElementById('mensaje');

    function mostrar(tipo, texto) {
        mensaje.className = tipo === 'exito'
            ? 'rounded-xl px-4 py-3 font-label-md text-label-md border border-primary/30 bg-primary/10 text-on-surface'
            : 'rounded-xl px-4 py-3 font-label-md text-label-md border border-error/30 bg-error-container text-on-error-container';
        mensaje.textContent = texto;
        mensaje.classList.remove('hidden');
    }

    form.addEventListener('submit', async function (evento) {
        evento.preventDefault();
        mensaje.classList.add('hidden');
        btn.disabled = true;

        var datos = {
            nombre: document.getElementById('nombre').value.trim(),
            documento: document.getElementById('documento').value.trim(),
            celular: document.getElementById('celular').value.trim(),
            direccion: document.getElementById('direccion').value.trim(),
            edad: Number(document.getElementById('edad').value),
            fechaNacimiento: document.getElementById('fechaNacimiento').value,
            cargo: document.getElementById('cargo').value.trim(),
            RH: document.getElementById('RH').value,
            salario: document.getElementById('salario').value,
            tareasRealizadas: Number(document.getElementById('tareasRealizadas').value)
        };

        // Token de sesión guardado en el navegador (si existe)
        var token = localStorage.getItem('token') || sessionStorage.getItem('token');
        var cabeceras = { 'Content-Type': 'application/json' };
        if (token) {
            cabeceras['Authorization'] = 'Bearer ' + token;
        }

        try {
            var respuesta = await fetch('/api/trabajadores', {
                method: 'POST',
                headers: cabeceras,
                body: JSON.stringify(datos)
            });

            var cuerpo = await respuesta.json().catch(function () { return null; });

            if (respuesta.ok) {
                mostrar('exito', 'Trabajador registrado correctamente.');
                form.reset();
                return;
            }

            if (respuesta.status === 401) {
                mostrar('error', 'Se requiere autenticación: inicia sesión para registrar trabajadores.');
                return;
            }

            mostrar('error', (cuerpo && cuerpo.error) ? cuerpo.error : 'No fue posible registrar al trabajador.');
        } catch (error) {
            mostrar('error', 'Error de conexión con el servidor.');
        } finally {
            btn.disabled = false;
        }
    });
})();
</script>
</body>
</html>
