MONGODB_URI=
MONGODB_DB=
PORT=
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=8h
API_KEY=
SESSION_TTL_HOURS=8
TRUST_PROXY=false

# Rate limits
RATE_LIMIT_API_MAX=600
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_MENSAJES_MAX=30
RATE_LIMIT_MENSAJES_WINDOW_MS=10000

# CSP: true solo para observar violaciones sin bloquear
CSP_REPORT_ONLY=false

# Backup automático (medianoche según BACKUP_TIMEZONE; por defecto, hora del servidor)
BACKUP_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
BACKUP_TIMEZONE=

# Administrador inicial (solo para `npm run admin:crear`)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NOMBRE=
